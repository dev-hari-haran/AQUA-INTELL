# Aquaculture Intelligence System (AIS) - Environment Variables Configuration

# General Application Settings
APP_NAME="Aquaculture Intelligence System"
APP_ENV=development
SECRET_KEY=change_this_to_a_secure_secret_key_in_production
DEBUG=True

# Database Configuration (PostgreSQL 16 + TimescaleDB + pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_USER=ais_admin
DB_PASSWORD=ais_password_123
DB_NAME=ais_db

# Redis & Celery Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# MQTT Broker Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=pond

# MinIO S3 Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_secret_password
MINIO_BUCKET_NAME=ais-storage
MINIO_SECURE=False

# Configurable Gen AI LLM API Provider (OpenAI, Anthropic, Ollama, or Local Mock)
LLM_PROVIDER=configurable
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL_NAME=gpt-4o-or-claude-3-5-sonnet

# Sentinel Hub API Configuration (Satellite Remote Sensing)
SENTINEL_CLIENT_ID=your_sentinel_client_id_here
SENTINEL_CLIENT_SECRET=your_sentinel_client_secret_here

# Model Storage Paths
MODEL_REGISTRY_DIR=./models/registry
